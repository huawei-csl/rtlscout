# Public rtl_scout .gitignore
# (the build script copies tracked files only, so this is mostly belt-and-suspenders)

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Secrets / env — NEVER commit real keys
.env
.env.*
!.env.template

# Run outputs / generated artifacts
/*.json
runs/
worker_*/
results/
output/
pareto_fronts/
paper_plots*/
images/
seeds_*/
rename/
.spire_cache/
obj_dir/
.pytest_cache/

# Excluded dependencies (not part of the public release)
deps/flowy/
deps/mockturtle/
deps/abc-eslim/

# Misc
*.patch
abc.history
.devcontainer/git_base_url.env

# Local git worktrees (e.g. spire-hdl submodule worktrees) live here; not part of this repo
.claude/worktrees/

# Keep benchmark metadata/inputs tracked (override broad ignores if you add any)
!benchmarks/**/*.json
!benchmarks/**/*.txt

runs_*/
logs_*/
plots/
*.blif
method_collection/
obsolete/

metadocuments/
# Optional Private nested checkout (internal GitLab repo) — never tracked here
/internal/
# Nested paper repo (mirrors an Overleaf project) — never tracked here
/paper/
inputs/
input/
.cache/

*.log
obj/
*.pdf
data/
artifacts/fpmul_run/state
*.png

# Spirehdl CEC baselines — regenerated by benchmarks/rtl_rewriter/_tools/augment_vectors.py
# (fpmul_f16/context/design.v stays tracked: its metadata golden_reference points at it)
benchmarks/rtl_rewriter_spirehdl/case*/context/design.v
artifacts/fpmul_run/verify_work/
# campaign outputs and run-state journals (READMEs stay tracked)
artifacts/fpmul_run/manifest_*.json
artifacts/fpmul_run/REPORT_*.md
artifacts/fpmul_run/figures/
artifacts/fpmul_run/STATUS.md
artifacts/rtlrewriter_run/STATUS.md
!deps/tech_eval/src/tech_eval/ppa_extract/data/
